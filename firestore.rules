rules_version = '2';

// Reglas de seguridad de Whereapp. Cópialas en: Consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function dentro() { return request.auth != null; }
    function esAdmin() { return dentro() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function esMoto() { return dentro() && exists(/databases/$(database)/documents/motorizados/$(request.auth.uid)); }
    function motoHabilitado() {
      let m = get(/databases/$(database)/documents/motorizados/$(request.auth.uid)).data;
      return m.activo == true && m.pagadoHasta > request.time;
    }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    // Identificador normal de Firestore (evita ids con comillas o etiquetas).
    function idNormal(id) { return id.matches('^[A-Za-z0-9]{20}$'); }
    function punto(p) { return p is map && p.lat is number && p.lng is number && p.dir is string && p.dir.size() <= 200; }
    function motoData(uid) { return get(/databases/$(database)/documents/motorizados/$(uid)).data; }
    function clienteData() { return get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data; }
    function tarifas() { return get(/databases/$(database)/documents/config/general).data; }
    function negocioData(nid) { return get(/databases/$(database)/documents/negocios/$(nid)).data; }
    function texto(v, max) { return v is string && v.size() <= max; }
    // Cliente bloqueado por el administrador: por su cuenta, su teléfono o su cédula (si la tiene).
    function clienteBloqueado() {
      let c = clienteData();
      return exists(/databases/$(database)/documents/bloqueados/$(request.auth.uid))
        || exists(/databases/$(database)/documents/bloqueados/$(c.get('telefono', '-')))
        || exists(/databases/$(database)/documents/bloqueados/$(c.get('cedula', '-')));
    }
    function codigoData(c) { return get(/databases/$(database)/documents/codigos/$(c)).data; }

    // ---------- Carrera nueva (dividida en partes para no pasar el límite de cálculos de Firestore) ----------
    function carreraNuevaOk(id, d) {
      let hayConfig = exists(/databases/$(database)/documents/config/general);
      let t = hayConfig ? tarifas() : {};
      return carreraCampos(d) && carreraDelCliente(d) && carreraDescuento(d, t) && carreraPin(id, d)
        && carreraNegocio(d) && carreraPrecio(d, t, hayConfig) && carreraBs(d, t, hayConfig) && carreraParaMoto(d);
    }
    function carreraCampos(d) {
      return d.keys().hasOnly(['clienteUid', 'clienteNombre', 'clienteTel', 'tipo', 'origen', 'destino', 'paradas', 'retorno', 'nota',
             'km', 'precio', 'recargos', 'ofertaCliente', 'precioSugerido', 'precioCliente', 'formaPago', 'tasa', 'precioBs', 'precioBsCliente',
             'estado', 'paraMoto', 'paraMotoNombre', 'motoUid', 'calificada', 'cancelaciones', 'creada', 'descuento',
             'negocio', 'pedido', 'totalProductos', 'conPin', 'codigo'])
        && d.clienteUid == request.auth.uid && d.estado == 'esperando' && d.motoUid == null
        && d.km is number && d.km >= 0 && d.km < 200
        && d.precio is number && d.precio > 0 && d.precio < 1000
        && punto(d.origen) && punto(d.destino)
        && (!('paradas' in d) || (d.paradas is list && d.paradas.size() <= 5))
        && d.get('precioCliente', d.precio) == d.precio
        && d.get('precioBsCliente', null) == d.get('precioBs', null)
        && d.get('calificada', false) == false
        && d.tipo in ['mototaxi', 'delivery']
        && d.get('formaPago', 'usd') in ['usd', 'bs', 'pagomovil']
        && texto(d.get('nota', ''), 300)
        && d.get('cancelaciones', []).size() == 0
        && d.creada == request.time;
    }
    // Desde la consola no se puede: usar otro nombre o teléfono, ni pedir varias seguidas
    // (la carrera va junto con la hora de su última carrera, que la ficha del cliente solo deja cambiar cada 20 s). Bloqueados no piden.
    function carreraDelCliente(d) {
      let c = clienteData();
      return d.clienteNombre is string && d.clienteNombre.size() <= 80
        && d.clienteNombre == c.nombre && d.clienteTel == c.telefono
        && getAfter(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.get('ultimaCarrera', null) == request.time
        && !clienteBloqueado();
    }
    // 50% (si el admin lo encendió, con su motivo) o código de promoción (activo y sin vencer). No se juntan.
    function carreraDescuento(d, t) {
      return (!('descuento' in d)
          || (t.get('descuento', {}).get('activa', false) == true
              && d.descuento == { 'pct': 50, 'motivo': t.get('descuento', {}).get('motivo', '') }))
        && (!('codigo' in d) || (!('descuento' in d) && codigoOk(d.codigo)));
    }
    function codigoOk(k) {
      let x = k.keys().hasOnly(['c', 'pct']) && k.c is string && k.c.matches('^[A-Z0-9]{3,20}$') ? codigoData(k.c) : null;
      return x != null && x.activo == true && x.vence > request.time && k.pct == x.pct;
    }
    // Código de 4 números para subir a la moto: se guarda aparte (el motorizado no lo puede leer).
    function carreraPin(id, d) {
      return d.get('conPin', false) == false
        || (d.conPin == true && d.tipo == 'mototaxi' && existsAfter(/databases/$(database)/documents/carreras/$(id)/privado/pin));
    }
    // Pedido a un negocio (Mercado o Comida rápida): delivery, de un negocio real y activo, con sus productos.
    function carreraNegocio(d) {
      return ('negocio' in d)
        ? (d.tipo == 'delivery' && d.negocio.keys().hasOnly(['id', 'nombre', 'telefono', 'dir']) && negocioOk(d.negocio)
           && d.pedido is list && d.pedido.size() > 0 && d.pedido.size() <= 40
           && d.totalProductos is number && d.totalProductos >= 0 && d.totalProductos < 100000)
        : (!('pedido' in d) && !('totalProductos' in d));
    }
    function negocioOk(n) {
      let x = negocioData(n.id);
      return x.get('activo', true) != false && n.nombre == x.nombre && n.telefono == x.telefono;
    }
    // Precio normal: no menos que la tarifa por distancia (con su descuento). Publicada: el cliente pone su precio.
    function carreraPrecio(d, t, hayConfig) {
      let tar = t.get(d.tipo, { 'base': 0, 'porKm': 0 });
      let factor = ('descuento' in d) ? 0.5 : (('codigo' in d) ? (100.0 - d.codigo.pct) / 100.0 : 1.0);
      return d.get('ofertaCliente', false) == true || !hayConfig
        || d.precio >= (tar.base + tar.porKm * (d.km - 0.06)) * factor - 0.02;
    }
    // En Bs: con la tasa del día y que cuadre con el precio en $.
    function carreraBs(d, t, hayConfig) {
      return d.get('precioBs', null) == null
        || (d.tasa is number && d.tasa > 0 && (!hayConfig || d.tasa == t.get('tasa', 0))
            && d.precioBs is number && math.abs(d.precioBs - d.precio * d.tasa) <= d.tasa * 0.02 + 1);
    }
    // Pedida a un motorizado: que exista y con su nombre real.
    function carreraParaMoto(d) {
      return d.get('paraMoto', null) == null || d.get('paraMotoNombre', null) == motoData(d.paraMoto).nombre;
    }

    // Hora puesta por el servidor (no se puede inventar una fecha desde la consola).
    function ahora(campo) { return request.resource.data[campo] == request.time; }

    match /admins/{uid} {
      allow read: if dentro() && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /motorizados/{uid} {
      allow read: if dentro();
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (dentro() && request.auth.uid == uid && soloCambia(['ubicacion', 'enCarrera', 'deTurno', 'pagoMovil', 'enApp', 'ultimaVez'])
        && request.resource.data.get('enApp', true) is bool
        && (!('ultimaVez' in request.resource.data) || request.resource.data.ultimaVez == request.time
            || request.resource.data.ultimaVez == resource.data.get('ultimaVez', null))
        && (!('ubicacion' in request.resource.data) || request.resource.data.ubicacion == null
            || (request.resource.data.ubicacion.lat is number && request.resource.data.ubicacion.lng is number))
        && (!('pagoMovil' in request.resource.data) || request.resource.data.pagoMovil == null
            || (request.resource.data.pagoMovil.keys().hasOnly(['banco', 'telefono', 'cedula'])
                && texto(request.resource.data.pagoMovil.banco, 60)
                && request.resource.data.pagoMovil.telefono.matches('^0[24][0-9]{2}-[0-9]{7}$')
                && request.resource.data.pagoMovil.cedula.matches('^[VEJ]-[0-9]{6,9}$'))));
    }

    // Ubicación en vivo del motorizado durante una carrera (la escribe él, cada pocos segundos).
    match /ubicaciones/{uid} {
      allow read: if dentro();
      allow create, update: if esMoto() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lat', 'lng', 't'])
        && request.resource.data.lat is number && request.resource.data.lng is number && request.resource.data.t is timestamp;
      // Al terminar la carrera el motorizado la borra (y el admin al eliminarlo).
      allow delete: if esAdmin() || (dentro() && request.auth.uid == uid);
    }

    // Opiniones públicas en el perfil del motorizado (copia de las reseñas que aprueba el admin).
    match /motorizados/{uid}/opiniones/{id} {
      allow read: if dentro();
      allow write: if esAdmin();
    }

    // Documentos del motorizado (licencia, certificado médico, RCV, trimestres): los sube el administrador;
    // solo los ven el administrador y el propio motorizado.
    match /documentos/{uid} {
      allow read: if esAdmin() || (dentro() && request.auth.uid == uid);
      allow write: if esAdmin();
      match /fotos/{tipo} {
        allow read: if esAdmin() || (dentro() && request.auth.uid == uid);
        allow write: if esAdmin();
      }
    }

    // Fotos del motorizado y de su moto (las sube el administrador).
    match /fotos/{uid} {
      allow read: if dentro();
      allow write: if esAdmin();
    }

    match /clientes/{uid} {
      allow read: if dentro() && request.auth.uid == uid;
      // Para entrar basta nombre y teléfono. La cédula es opcional (clientes viejos la tienen) y no se puede cambiar ni borrar.
      allow create, update: if dentro() && request.auth.uid == uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 5 && request.resource.data.nombre.size() <= 80
        && (!('cedula' in request.resource.data) || (request.resource.data.cedula is string && request.resource.data.cedula.matches('^[VE]-[0-9]{6,9}$')))
        && request.resource.data.telefono is string && request.resource.data.telefono.matches('^[+]58[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['nombre', 'cedula', 'telefono', 'creado', 'politicas', 'ultimaCarrera', 'enApp', 'ultimaVez'])
        && request.resource.data.get('enApp', true) is bool
        && (!('ultimaVez' in request.resource.data) || request.resource.data.ultimaVez == request.time
            || (resource != null && request.resource.data.ultimaVez == resource.data.get('ultimaVez', null)))
        && (resource == null || request.resource.data.get('cedula', null) == resource.data.get('cedula', null))
        // La hora de su última carrera solo la pone el servidor, y como mucho una vez cada 20 s (no se puede pedir varias seguidas).
        // Tampoco se puede borrar para saltarse la espera.
        && (!('ultimaCarrera' in request.resource.data)
            || (resource != null && request.resource.data.ultimaCarrera == resource.data.get('ultimaCarrera', null))
            || (request.resource.data.ultimaCarrera == request.time
                && (resource == null || !('ultimaCarrera' in resource.data) || resource.data.ultimaCarrera < request.time - duration.value(20, 's')
                    || resource.data.ultimaCarrera == request.time)))
        && (resource == null || !('ultimaCarrera' in resource.data) || 'ultimaCarrera' in request.resource.data);
      // Puede eliminar su cuenta (Play Store lo exige). Los bloqueos por teléfono siguen en /bloqueados.
      allow delete: if dentro() && request.auth.uid == uid;
      allow read, update: if esAdmin();
    }

    // Solicitudes para trabajar como motorizado: cada persona (cuenta anónima) envía la suya; solo ella y el admin la ven.
    // Puede reenviarla si se la rechazaron. El admin la aprueba (y crea la cuenta) o la rechaza con un motivo.
    function solicitudOk(d) {
      return d.keys().hasOnly(['nombre', 'telefono', 'cedula', 'moto', 'placa', 'color', 'estado', 'creada'])
        && d.nombre is string && d.nombre.size() >= 5 && d.nombre.size() <= 80
        && d.telefono is string && d.telefono.matches('^[+]58[0-9]{10}$')
        && d.cedula is string && d.cedula.matches('^[VE]-[0-9]{6,9}$')
        && texto(d.moto, 60) && d.moto.size() > 0 && texto(d.placa, 12) && d.placa.size() > 0 && texto(d.get('color', ''), 30)
        && d.estado == 'pendiente' && d.creada == request.time;
    }
    match /solicitudes/{uid} {
      allow get: if esAdmin() || (dentro() && request.auth.uid == uid);
      allow list: if esAdmin();
      allow create: if dentro() && request.auth.uid == uid && solicitudOk(request.resource.data);
      allow update: if esAdmin()
        || (dentro() && request.auth.uid == uid && resource.data.estado == 'rechazada' && solicitudOk(request.resource.data));
      allow delete: if esAdmin();
      match /fotos/{k} {
        allow read: if esAdmin() || (dentro() && request.auth.uid == uid);
        allow create, update: if dentro() && request.auth.uid == uid
          && k in ['persona', 'moto', 'cedula', 'licencia', 'medico', 'rcv']
          && request.resource.data.keys().hasOnly(['foto']) && request.resource.data.foto is string
          && request.resource.data.foto.size() < 900000;
        allow delete: if esAdmin();
      }
    }

    // Clientes bloqueados por el administrador (por cuenta, teléfono o cédula): no pueden pedir carreras.
    match /bloqueados/{cedula} {
      allow get: if dentro();
      allow list, write: if esAdmin();
    }

    // Negocios de "Mercado a tu casa" y "Comida rápida", y sus productos: los carga el administrador y los ven los clientes.
    match /negocios/{id} {
      allow read: if dentro();
      allow write: if esAdmin();
    }
    match /productos/{id} {
      allow read: if dentro();
      allow write: if esAdmin();
      // «Lo más pedido»: al pedir, el cliente suma lo que llevó de cada producto (solo puede sumar, de 1 a 20).
      allow update: if dentro() && soloCambia(['vendidos'])
        && request.resource.data.vendidos is int
        && request.resource.data.vendidos - resource.data.get('vendidos', 0) >= 1
        && request.resource.data.vendidos - resource.data.get('vendidos', 0) <= 20;
    }

    // Códigos de promoción: los crea el administrador. Un cliente solo puede consultar el que escribió (no la lista).
    match /codigos/{c} {
      allow get: if dentro();
      allow list, write: if esAdmin();
    }

    // Puntos de referencia del mapa: los agrega el administrador y los ven todos.
    match /lugares/{id} {
      allow read: if dentro();
      allow write: if esAdmin();
    }

    match /carreras/{id} {
      // Una carrera sola se puede abrir con su id (enlace de seguimiento que el cliente comparte),
      // durante las 24 horas desde que se pidió (así el amigo ve que llegó bien); después, solo quien participó.
      allow get: if esAdmin()
        || (dentro() && (resource.data.clienteUid == request.auth.uid || resource.data.get('motoUid', null) == request.auth.uid))
        || (dentro() && (resource.data.estado in ['esperando', 'aceptada']
            || (resource.data.creada is timestamp && request.time < resource.data.creada + duration.value(24, 'h'))));
      // Las listas solo las ve quien participa.
      allow list: if esAdmin()
        || (dentro() && resource.data.clienteUid == request.auth.uid)
        || (esMoto() && resource.data.motoUid == request.auth.uid)
        || (esMoto() && resource.data.estado == 'esperando' && motoHabilitado());

      allow create: if dentro() && idNormal(id) && carreraNuevaOk(id, request.resource.data);

      allow update: if esAdmin()
        // El cliente cancela su carrera…
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado in ['esperando', 'aceptada']
            && request.resource.data.estado == 'cancelada'
            && request.resource.data.cancelacion.keys().hasOnly(['por', 'motivo', 'fecha'])
            && request.resource.data.cancelacion.por == 'cliente' && texto(request.resource.data.cancelacion.motivo, 300)
            && soloCambia(['estado', 'cancelacion']))
        // …acepta la contraoferta de un motorizado (con el precio que él ofreció)…
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado == 'esperando'
            && request.resource.data.estado == 'aceptada'
            && exists(/databases/$(database)/documents/carreras/$(id)/ofertas/$(request.resource.data.motoUid))
            && request.resource.data.precio == get(/databases/$(database)/documents/carreras/$(id)/ofertas/$(request.resource.data.motoUid)).data.precio
            && request.resource.data.get('precioBs', null) == get(/databases/$(database)/documents/carreras/$(id)/ofertas/$(request.resource.data.motoUid)).data.get('precioBs', null)
            && motoData(request.resource.data.motoUid).get('enCarrera', false) != true
            && motoData(request.resource.data.motoUid).activo == true
            && motoData(request.resource.data.motoUid).pagadoHasta > request.time
            && request.resource.data.motoNombre == motoData(request.resource.data.motoUid).nombre
            && request.resource.data.motoTel == motoData(request.resource.data.motoUid).get('telefono', '')
            && motoData(request.resource.data.motoUid).get('deTurno', true) != false
            && ahora('aceptada')
            && soloCambia(['estado', 'motoUid', 'motoNombre', 'motoTel', 'motoMoto', 'motoPlaca', 'aceptada', 'precio', 'precioBs', 'contraoferta']))
        // …avisa una emergencia (SOS) durante el viaje…
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado == 'aceptada'
            && (!('sosUbic' in request.resource.data) || (request.resource.data.sosUbic.lat is number && request.resource.data.sosUbic.lng is number))
            && ahora('sos')
            && soloCambia(['sos', 'sosUbic']))
        // …o la califica cuando terminó.
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado == 'terminada'
            && request.resource.data.calificada == true
            && soloCambia(['calificada']))
        // El motorizado acepta una carrera disponible.
        || (esMoto() && motoHabilitado()
            && resource.data.estado == 'esperando'
            && (resource.data.paraMoto == null || resource.data.paraMoto == request.auth.uid)
            && request.resource.data.estado == 'aceptada'
            && request.resource.data.motoUid == request.auth.uid
            // Sus datos reales (nadie puede hacerse pasar por otro) y una sola carrera a la vez.
            && request.resource.data.motoNombre == motoData(request.auth.uid).nombre
            && request.resource.data.motoTel == motoData(request.auth.uid).get('telefono', '')
            && request.resource.data.motoPlaca == motoData(request.auth.uid).get('placa', '')
            && motoData(request.auth.uid).get('enCarrera', false) != true
            && ahora('aceptada')
            && soloCambia(['estado', 'motoUid', 'motoNombre', 'motoTel', 'motoMoto', 'motoPlaca', 'aceptada']))
        // El motorizado avisa que ya recogió, termina o cancela su carrera (al cancelar vuelve a quedar disponible).
        || (esMoto() && resource.data.motoUid == request.auth.uid && resource.data.estado == 'aceptada'
            // Al recoger al pasajero: si la carrera tiene código, el motorizado debe escribir el que le dice el pasajero.
            && ((request.resource.data.estado == 'aceptada' && request.resource.data.recogido == true && ahora('recogidoEn') && soloCambia(['recogido', 'recogidoEn', 'pin'])
                 && (resource.data.get('conPin', false) != true
                     || request.resource.data.get('pin', '') == get(/databases/$(database)/documents/carreras/$(id)/privado/pin).data.pin))
             || (request.resource.data.estado == 'aceptada' && ahora('llegoEn') && soloCambia(['llegoEn']))
             || (request.resource.data.estado == 'terminada' && ahora('terminada') && soloCambia(['estado', 'terminada']))
             // Cancelar: solo antes de recoger; vuelve al precio original del cliente (si hubo contraoferta).
             || (request.resource.data.estado == 'esperando' && request.resource.data.motoUid == null
                 && resource.data.get('recogido', false) != true
                 && request.resource.data.paraMoto == null
                 && request.resource.data.cancelaciones is list
                 && request.resource.data.cancelaciones.size() == resource.data.get('cancelaciones', []).size() + 1
                 && request.resource.data.get('precio', 0) == resource.data.get('precioCliente', resource.data.get('precio', 0))
                 && request.resource.data.get('precioBs', null) == resource.data.get('precioBsCliente', resource.data.get('precioBs', null))
                 && request.resource.data.get('paraMotoNombre', null) == null
                 && request.resource.data.get('contraoferta', false) == false
                 && soloCambia(['estado', 'motoUid', 'paraMoto', 'paraMotoNombre', 'cancelaciones', 'recogido', 'llegoEn',
                                'motoNombre', 'motoTel', 'motoMoto', 'motoPlaca', 'precio', 'precioBs', 'contraoferta']))));
    }

    // Código para subir a la moto: lo crea el cliente junto con su carrera y solo él (y el admin) lo ve.
    match /carreras/{cid}/privado/{d} {
      allow get: if esAdmin() || (dentro() && get(/databases/$(database)/documents/carreras/$(cid)).data.clienteUid == request.auth.uid);
      allow create: if dentro() && d == 'pin'
        && !exists(/databases/$(database)/documents/carreras/$(cid))
        && getAfter(/databases/$(database)/documents/carreras/$(cid)).data.clienteUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/carreras/$(cid)).data.get('conPin', false) == true
        && request.resource.data.keys().hasOnly(['pin']) && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4}$');
    }

    // Contraofertas: cada motorizado propone su precio en una carrera publicada por el cliente.
    match /carreras/{cid}/ofertas/{motoId} {
      function carreraO() { return get(/databases/$(database)/documents/carreras/$(cid)).data; }
      allow read: if esAdmin() || (dentro() && (carreraO().clienteUid == request.auth.uid || request.auth.uid == motoId));
      allow create, update: if esMoto() && request.auth.uid == motoId && motoHabilitado()
        && carreraO().estado == 'esperando' && carreraO().paraMoto == null
        && request.resource.data.motoUid == motoId
        && request.resource.data.precio is number && request.resource.data.precio > 0 && request.resource.data.precio < 1000
        && request.resource.data.keys().hasOnly(['motoUid', 'nombre', 'telefono', 'moto', 'placa', 'ratingSum', 'ratingCount', 'seguroSi', 'seguroN', 'precio', 'precioBs', 'fecha'])
        && request.resource.data.nombre == motoData(motoId).nombre
        && (request.resource.data.get('precioBs', null) == null || request.resource.data.precioBs is number)
        && ahora('fecha');
      allow delete: if dentro() && request.auth.uid == motoId;
    }

    // Chat de la carrera: solo el cliente y el motorizado asignado (el admin puede leer).
    match /carreras/{cid}/mensajes/{mid} {
      function carrera() { return get(/databases/$(database)/documents/carreras/$(cid)).data; }
      function participa() { return dentro() && (carrera().clienteUid == request.auth.uid || carrera().motoUid == request.auth.uid); }
      allow read: if participa() || esAdmin();
      allow create: if participa()
        && carrera().estado == 'aceptada'
        && request.resource.data.keys().hasOnly(['de', 'nombre', 'texto', 'fecha'])
        && request.resource.data.fecha == request.time
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && request.resource.data.de == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500;
    }

    // El motorizado califica al cliente al terminar (solo el admin las ve).
    match /calificacionesClientes/{id} {
      // Una por carrera (su id es el de la carrera) y solo cuando terminó.
      allow create: if esMoto() && id == request.resource.data.carreraId
        && request.resource.data.motoUid == request.auth.uid
        && get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.motoUid == request.auth.uid
        && get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.estado == 'terminada'
        && request.resource.data.clienteUid == get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.clienteUid
        && request.resource.data.keys().hasOnly(['carreraId', 'motoUid', 'motoNombre', 'clienteUid', 'clienteNombre', 'estrellas', 'comentario', 'fecha'])
        && texto(request.resource.data.get('comentario', ''), 300) && ahora('fecha')
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5;
      allow read: if esAdmin();
    }

    match /resenas/{id} {
      // Una sola reseña por carrera: su id es el de la carrera (repetirla sería "editar", y eso solo lo hace el admin).
      allow create: if dentro() && id == request.resource.data.carreraId
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.fecha == request.time
        && !clienteBloqueado()
        && request.resource.data.clienteNombre == get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.nombre
        && get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.clienteUid == request.auth.uid
        && get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.motoUid == request.resource.data.motoUid
        && get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.estado == 'terminada'
        && get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.get('calificada', false) == false
        && (!('comentario' in request.resource.data) || (request.resource.data.comentario is string && request.resource.data.comentario.size() <= 500))
        // Etiquetas como listas y "seguro" sí/no (un dato raro dejaba en blanco la pantalla de reseñas del admin).
        && (!('malos' in request.resource.data) || (request.resource.data.malos is list && request.resource.data.malos.size() <= 10))
        && (!('buenos' in request.resource.data) || (request.resource.data.buenos is list && request.resource.data.buenos.size() <= 10))
        && (!('seguro' in request.resource.data) || request.resource.data.seguro is bool || request.resource.data.seguro == null)
        && request.resource.data.aprobada == false
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5;
      allow read, update, delete: if esAdmin();
    }

    // El motorizado reporta el pago de su cuota; el administrador lo aprueba o lo rechaza.
    match /reportesPago/{id} {
      allow create: if esMoto() && idNormal(id) && request.resource.data.motoUid == request.auth.uid && request.resource.data.estado == 'pendiente'
        && request.resource.data.referencia is string && request.resource.data.referencia.size() <= 20
        && request.resource.data.monto is number && request.resource.data.monto > 0 && request.resource.data.monto < 100000
        && request.resource.data.keys().hasOnly(['motoUid', 'nombre', 'referencia', 'monto', 'moneda', 'fechaPago', 'estado', 'creado'])
        && request.resource.data.moneda in ['bs', 'usd'] && texto(request.resource.data.get('fechaPago', ''), 10)
        && request.resource.data.nombre == motoData(request.auth.uid).nombre && ahora('creado');
      allow read: if esAdmin() || (dentro() && resource.data.motoUid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Token para avisos push (uno por persona): solo lo escribe su dueño; lo lee el servidor (Cloud Functions).
    match /tokens/{uid} {
      allow create, update: if dentro() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t', 'rol', 'actualizado'])
        && texto(request.resource.data.t, 4096) && request.resource.data.rol in ['cliente', 'moto', 'admin']
        && (request.resource.data.rol != 'admin' || esAdmin())
        && (request.resource.data.rol != 'moto' || esMoto())
        && request.resource.data.actualizado == request.time;
      allow delete: if dentro() && request.auth.uid == uid;
    }

    // Publicidad de negocios (banners del inicio): la carga el admin. Los pasajeros solo suman 1 vista o 1 toque.
    match /anuncios/{id} {
      allow read: if dentro();
      allow write: if esAdmin();
      allow update: if dentro()
        && ((soloCambia(['vistas']) && request.resource.data.vistas == resource.data.get('vistas', 0) + 1)
            || (soloCambia(['toques']) && request.resource.data.toques == resource.data.get('toques', 0) + 1));
    }

    // Avisos (push) a todos los pasajeros: los escribe el admin y los envía el servidor.
    match /promos/{id} {
      allow read, write: if esAdmin();
    }

    match /pagos/{id} {
      allow read, write: if esAdmin();
    }

    match /llamadas/{motoUid} {
      allow read, delete: if esAdmin();
      allow create: if dentro() && exists(/databases/$(database)/documents/motorizados/$(motoUid))
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if dentro() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // Toques en el botón de la publicidad: los clientes solo pueden sumar 1; el admin lo pone en cero.
    match /stats/publicidad {
      allow read, write: if esAdmin();
      allow create: if dentro() && request.resource.data.keys().hasOnly(['toques']) && request.resource.data.toques == 1;
      allow update: if dentro() && request.resource.data.keys().hasOnly(['toques']) && request.resource.data.toques == resource.data.toques + 1;
    }

    match /stats/visitas {
      allow read: if esAdmin();
      // Solo se puede sumar 1 visita (nada de borrar ni poner textos raros).
      allow create: if dentro() && request.resource.data.keys().hasOnly(['total', 'dias'])
        && request.resource.data.total == 1 && request.resource.data.dias is map && request.resource.data.dias.size() == 1;
      // Solo se suma en el día de hoy: no se pueden borrar ni cambiar los otros días.
      allow update: if dentro() && request.resource.data.keys().hasOnly(['total', 'dias'])
        && request.resource.data.total == resource.data.total + 1 && request.resource.data.dias is map
        && request.resource.data.dias.diff(resource.data.dias).removedKeys().size() == 0
        && request.resource.data.dias.diff(resource.data.dias).affectedKeys().size() == 1;
    }
  }
}
