rules_version = '2';

// Reglas de seguridad de Whereapp. Cópialas en: Consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function dentro() { return request.auth != null; }
    function esAdmin() { return dentro() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function esMoto() { return dentro() && exists(/databases/$(database)/documents/motorizados/$(request.auth.uid)); }
    function motoHabilitado() {
      let m = get(/databases/$(database)/documents/motorizados/$(request.auth.uid)).data;
      return m.activo == true && m.pagadoHasta > request.time;
    }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    match /admins/{uid} {
      allow read: if dentro() && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /motorizados/{uid} {
      allow read: if dentro();
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (dentro() && request.auth.uid == uid && soloCambia(['ubicacion', 'enCarrera', 'deTurno', 'pagoMovil']));
    }

    // Opiniones públicas en el perfil del motorizado (copia de las reseñas que aprueba el admin).
    match /motorizados/{uid}/opiniones/{id} {
      allow read: if dentro();
      allow write: if esAdmin();
    }

    // Fotos del motorizado y de su moto (las sube el administrador).
    match /fotos/{uid} {
      allow read: if dentro();
      allow write: if esAdmin();
    }

    match /clientes/{uid} {
      allow read: if dentro() && request.auth.uid == uid;
      allow write: if dentro() && request.auth.uid == uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 5
        && request.resource.data.cedula is string && request.resource.data.cedula.matches('^[VE]-[0-9]{6,9}$')
        && request.resource.data.telefono is string && request.resource.data.telefono.matches('^[+]58[0-9]{10}$');
      allow read, update: if esAdmin();
    }

    // Cédulas bloqueadas por el administrador: esos clientes no pueden pedir carreras.
    match /bloqueados/{cedula} {
      allow get: if dentro();
      allow list, write: if esAdmin();
    }

    // Puntos de referencia del mapa: los agrega el administrador y los ven todos.
    match /lugares/{id} {
      allow read: if dentro();
      allow write: if esAdmin();
    }

    match /carreras/{id} {
      // Una carrera sola se puede abrir con su id (enlace de seguimiento que el cliente comparte).
      allow get: if dentro();
      // Las listas solo las ve quien participa.
      allow list: if esAdmin()
        || (dentro() && resource.data.clienteUid == request.auth.uid)
        || (esMoto() && resource.data.motoUid == request.auth.uid)
        || (esMoto() && resource.data.estado == 'esperando' && motoHabilitado());

      allow create: if dentro()
        && request.resource.data.clienteUid == request.auth.uid
        && !exists(/databases/$(database)/documents/bloqueados/$(get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.cedula))
        && request.resource.data.estado == 'esperando'
        && request.resource.data.motoUid == null;

      allow update: if esAdmin()
        // El cliente cancela su carrera…
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado in ['esperando', 'aceptada']
            && request.resource.data.estado == 'cancelada'
            && soloCambia(['estado', 'cancelacion']))
        // …acepta la contraoferta de un motorizado (con el precio que él ofreció)…
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado == 'esperando'
            && request.resource.data.estado == 'aceptada'
            && exists(/databases/$(database)/documents/carreras/$(id)/ofertas/$(request.resource.data.motoUid))
            && request.resource.data.precio == get(/databases/$(database)/documents/carreras/$(id)/ofertas/$(request.resource.data.motoUid)).data.precio
            && soloCambia(['estado', 'motoUid', 'motoNombre', 'motoTel', 'motoMoto', 'motoPlaca', 'aceptada', 'precio', 'precioBs', 'contraoferta']))
        // …avisa una emergencia (SOS) durante el viaje…
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado == 'aceptada'
            && soloCambia(['sos', 'sosUbic']))
        // …o la califica cuando terminó.
        || (dentro() && resource.data.clienteUid == request.auth.uid
            && resource.data.estado == 'terminada'
            && soloCambia(['calificada']))
        // El motorizado acepta una carrera disponible.
        || (esMoto() && motoHabilitado()
            && resource.data.estado == 'esperando'
            && (resource.data.paraMoto == null || resource.data.paraMoto == request.auth.uid)
            && request.resource.data.estado == 'aceptada'
            && request.resource.data.motoUid == request.auth.uid
            && soloCambia(['estado', 'motoUid', 'motoNombre', 'motoTel', 'motoMoto', 'motoPlaca', 'aceptada']))
        // El motorizado avisa que ya recogió, termina o cancela su carrera (al cancelar vuelve a quedar disponible).
        || (esMoto() && resource.data.motoUid == request.auth.uid && resource.data.estado == 'aceptada'
            && ((request.resource.data.estado == 'aceptada' && request.resource.data.recogido == true && soloCambia(['recogido', 'recogidoEn']))
             || (request.resource.data.estado == 'aceptada' && soloCambia(['llegoEn']))
             || (request.resource.data.estado == 'terminada' && soloCambia(['estado', 'terminada']))
             || (request.resource.data.estado == 'esperando' && request.resource.data.motoUid == null
                 && soloCambia(['estado', 'motoUid', 'paraMoto', 'paraMotoNombre', 'cancelaciones', 'recogido', 'llegoEn']))));
    }

    // Contraofertas: cada motorizado propone su precio en una carrera publicada por el cliente.
    match /carreras/{cid}/ofertas/{motoId} {
      function carreraO() { return get(/databases/$(database)/documents/carreras/$(cid)).data; }
      allow read: if esAdmin() || (dentro() && (carreraO().clienteUid == request.auth.uid || request.auth.uid == motoId));
      allow create, update: if esMoto() && request.auth.uid == motoId && motoHabilitado()
        && carreraO().estado == 'esperando' && carreraO().paraMoto == null
        && request.resource.data.motoUid == motoId
        && request.resource.data.precio is number && request.resource.data.precio > 0;
      allow delete: if dentro() && request.auth.uid == motoId;
    }

    // Chat de la carrera: solo el cliente y el motorizado asignado (el admin puede leer).
    match /carreras/{cid}/mensajes/{mid} {
      function carrera() { return get(/databases/$(database)/documents/carreras/$(cid)).data; }
      function participa() { return dentro() && (carrera().clienteUid == request.auth.uid || carrera().motoUid == request.auth.uid); }
      allow read: if participa() || esAdmin();
      allow create: if participa()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500;
    }

    // El motorizado califica al cliente al terminar (solo el admin las ve).
    match /calificacionesClientes/{id} {
      allow create: if esMoto()
        && request.resource.data.motoUid == request.auth.uid
        && get(/databases/$(database)/documents/carreras/$(request.resource.data.carreraId)).data.motoUid == request.auth.uid
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5;
      allow read: if esAdmin();
    }

    match /resenas/{id} {
      allow create: if dentro()
        && request.resource.data.clienteUid == request.auth.uid
        && !exists(/databases/$(database)/documents/bloqueados/$(get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.cedula))
        && request.resource.data.aprobada == false
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5;
      allow read, update, delete: if esAdmin();
    }

    // El motorizado reporta el pago de su cuota; el administrador lo aprueba o lo rechaza.
    match /reportesPago/{id} {
      allow create: if esMoto() && request.resource.data.motoUid == request.auth.uid && request.resource.data.estado == 'pendiente';
      allow read: if esAdmin() || (dentro() && resource.data.motoUid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    match /pagos/{id} {
      allow read, write: if esAdmin();
    }

    match /llamadas/{motoUid} {
      allow read: if esAdmin();
      allow create: if dentro() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if dentro() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    match /stats/visitas {
      allow read: if esAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['total', 'dias']);
    }
  }
}
