<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget"
    android:orientation="vertical"
    android:padding="10dp">
    <TextView
        android:id="@+id/titulo_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingBottom="4dp"
        android:text="Whereapp · El Moján"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/boton_pedir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/fondo_boton_widget"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_moto" android:contentDescription="Pedir moto" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Pedir moto" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/boton_casa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/fondo_boton_widget"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_casa" android:contentDescription="Ir a casa" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Ir a casa" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/boton_viaje"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/fondo_boton_widget"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_ruta" android:contentDescription="Mi viaje" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Mi viaje" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
